{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tamnex:schema:pricing-catalog:v1",
  "title": "pricing-catalog v1",
  "description": "Public read projection of the published commercial catalog (SA-11 TRD r1.4 section 20.4). Frozen once merged: any change, even an optional field, is a new v2 file.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "catalog_revision",
    "generated_at",
    "currency",
    "tax",
    "plans"
  ],
  "properties": {
    "schema": { "const": "pricing-catalog" },
    "schema_version": { "const": 1 },
    "catalog_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "generated_at": { "$ref": "#/$defs/timestamp_utc" },
    "currency": { "const": "SAR" },
    "tax": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prices_exclude_vat", "vat_percent", "jurisdiction"],
      "properties": {
        "prices_exclude_vat": { "type": "boolean" },
        "vat_percent": { "type": "string", "pattern": "^(100\\.00|[0-9]{1,2}\\.[0-9]{2})$" },
        "jurisdiction": { "const": "SA" }
      }
    },
    "plans": { "type": "array", "items": { "$ref": "#/$defs/plan" } }
  },
  "$defs": {
    "timestamp_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?Z$"
    },
    "money": { "type": "string", "pattern": "^[0-9]{1,12}\\.[0-9]{2}$" },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "bilingual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ar", "en"],
      "properties": {
        "ar": { "type": "string", "minLength": 1, "maxLength": 60 },
        "en": { "type": "string", "minLength": 1, "maxLength": 60 }
      }
    },
    "feature_label": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ar", "en"],
      "properties": {
        "ar": { "type": "string", "minLength": 1, "maxLength": 120 },
        "en": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_id",
        "plan_version_id",
        "version_no",
        "published_at",
        "display_order",
        "name",
        "pricing",
        "features",
        "limits"
      ],
      "properties": {
        "plan_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,31}$" },
        "plan_version_id": { "$ref": "#/$defs/uuid" },
        "version_no": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "published_at": { "$ref": "#/$defs/timestamp_utc" },
        "display_order": { "type": "integer", "minimum": 0, "maximum": 32767 },
        "name": { "$ref": "#/$defs/bilingual" },
        "pricing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cycles"],
          "properties": {
            "cycles": {
              "type": "object",
              "additionalProperties": false,
              "required": ["monthly", "annual"],
              "properties": {
                "monthly": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["amount", "amount_incl_vat"],
                  "properties": {
                    "amount": { "$ref": "#/$defs/money" },
                    "amount_incl_vat": { "$ref": "#/$defs/money" }
                  }
                },
                "annual": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "amount_per_month",
                    "amount_total",
                    "amount_total_incl_vat",
                    "billed"
                  ],
                  "properties": {
                    "amount_per_month": { "$ref": "#/$defs/money" },
                    "amount_total": { "$ref": "#/$defs/money" },
                    "amount_total_incl_vat": { "$ref": "#/$defs/money" },
                    "billed": { "const": "upfront" }
                  }
                }
              }
            }
          }
        },
        "features": { "type": "array", "items": { "$ref": "#/$defs/feature" } },
        "limits": { "type": "array", "items": { "$ref": "#/$defs/limit" } }
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "label", "order", "state", "availability"],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,40}$" },
        "label": { "$ref": "#/$defs/feature_label" },
        "order": { "type": "integer", "minimum": 0, "maximum": 32767 },
        "state": { "enum": ["included", "not_included"] },
        "availability": { "enum": ["available", "coming_soon"] }
      }
    },
    "limit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "unit", "unlimited", "value", "extra_paid"],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,40}$" },
        "unit": { "$ref": "#/$defs/bilingual" },
        "unlimited": { "type": "boolean" },
        "value": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 },
        "extra_paid": { "type": "boolean" }
      },
      "if": { "properties": { "unlimited": { "const": true } }, "required": ["unlimited"] },
      "then": { "properties": { "value": { "type": "null" } } },
      "else": { "properties": { "value": { "type": "integer" } } }
    }
  }
}
